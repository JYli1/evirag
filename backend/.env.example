# EviRAG 后端本地开发配置样例。
# 使用方式：复制本文件为 backend/.env，然后把占位值改成本机真实配置。
# 安全要求：backend/.env 中会保存数据库密码、邮箱授权码和模型 API Key，禁止提交到 Git。
# 读取规则：后端启动时会优先使用 JVM -D 参数和系统环境变量；这些都不存在时才读取 backend/.env。

# 后端 HTTP 服务端口。
# 默认 8080；如果本机 8080 被占用，可以改成 8081、8090 等未占用端口。
APP_PORT=8080

# 上传文件保存目录。
# 相对路径会以 backend 工作目录为基准；默认 ./uploads 即 backend/uploads。
# 如果想把文件放到固定磁盘目录，可以改成 D:\evirag\uploads 这类绝对路径。
APP_UPLOAD_DIR=./uploads

# 单个上传文件的大小上限，单位 MB。
# 默认 20MB；课程演示通常够用，上传大 PDF 时可以适当调大。
APP_MAX_FILE_SIZE_MB=20

# MySQL 主机地址。
# 本机 MySQL 使用 localhost；如果数据库在其他机器或容器中，改成对应 IP 或域名。
DB_HOST=localhost

# MySQL 端口。
# MySQL 默认端口是 3306；只有数据库改过端口时才需要修改。
DB_PORT=3306

# MySQL 数据库名。
# 需要先手动创建该数据库，表结构由 Flyway 在后端启动时自动创建。
DB_NAME=rag_doc_qa

# MySQL 用户名。
# 本地演示可以使用 root；正式环境建议使用权限更小的专用账号。
DB_USERNAME=root

# MySQL 密码。
# 填写 DB_USERNAME 对应账号的真实密码；没有密码时可以留空。
DB_PASSWORD=

# MySQL 连接池单个连接最大存活时间，单位毫秒。
# 600000 表示 10 分钟；比 MySQL wait_timeout 更短可以减少 Hikari 校验已关闭连接的 WARN。
DB_POOL_MAX_LIFETIME_MS=600000

# MySQL 连接池保活间隔，单位毫秒。
# 300000 表示 5 分钟；用于定期保活空闲连接，降低本地 MySQL 关闭空闲连接的概率。
DB_POOL_KEEPALIVE_TIME_MS=300000

# MySQL 连接校验超时时间，单位毫秒。
# 默认 5000；本地开发一般无需修改。
DB_POOL_VALIDATION_TIMEOUT_MS=5000

# JWT 签名密钥。
# 用于签发和校验登录 token，必须换成足够长的随机字符串；不要使用默认值部署。
JWT_SECRET=change-me-to-a-long-random-secret

# JWT 登录有效期，单位分钟。
# 1440 表示 24 小时；如果想保持登录 7 天，可以改成 10080。
JWT_EXPIRE_MINUTES=1440

# SMTP 邮件服务器地址。
# QQ 邮箱使用 smtp.qq.com；其他邮箱需要改成对应 SMTP 服务器。
MAIL_HOST=smtp.qq.com

# SMTP 邮件服务器端口。
# QQ 邮箱 SSL 通常使用 465；如果改用 STARTTLS 端口，需要后端额外支持对应配置。
MAIL_PORT=465

# 发件邮箱账号。
# 使用 QQ 邮箱时填完整邮箱地址，例如 example@qq.com。
MAIL_USERNAME=

# 发件邮箱授权码。
# 使用 QQ 邮箱时这里填 SMTP 授权码，不是 QQ 登录密码。
MAIL_PASSWORD=

# 邮件 From 地址。
# 通常与 MAIL_USERNAME 保持一致；验证码邮件会显示从该地址发出。
MAIL_FROM=

# 是否启用 SMTP SSL。
# QQ 邮箱 465 端口需要 true；普通 25 端口通常是 false。
MAIL_SSL=true

# LLM 接口基础地址。
# 使用 OpenAI 官方接口时保持 https://api.openai.com/v1；使用兼容接口时改成对应服务地址。
LLM_BASE_URL=https://api.openai.com/v1

# LLM API Key。
# 用于调用聊天模型生成回答；不配置时问答接口无法正常生成模型回复。
LLM_API_KEY=

# LLM 模型名。
# 需要填写服务商支持的聊天模型名，例如 gpt-4o-mini 或第三方兼容模型名。
LLM_MODEL=gpt-4o-mini

# LLM 请求超时时间，单位秒。
# 网络较慢或模型响应较慢时可以适当调大。
LLM_TIMEOUT_SECONDS=60

# embedding 接口基础地址。
# 默认使用硅基流动 OpenAI 兼容接口；如果使用其他 embedding 服务，改成对应 base url。
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1

# embedding API Key。
# 用于把文档分块和用户问题转换成向量；不配置时文档无法完成入库检索。
EMBEDDING_API_KEY=

# embedding 模型名。
# 填写硅基流动或其他服务商提供的 embedding 模型名，必须与接口服务支持的名称一致。
EMBEDDING_MODEL=

# embedding 请求超时时间，单位秒。
# 文档较长或网络较慢时可以适当调大。
EMBEDDING_TIMEOUT_SECONDS=60

# Chroma 服务主机地址。
# 本机运行 Chroma 时使用 127.0.0.1；如果 Chroma 在其他机器或容器中，改成对应地址。
CHROMA_HOST=127.0.0.1

# Chroma 服务端口。
# 默认 8000；需要与 chroma run 启动时的 --port 保持一致。
CHROMA_PORT=8000

# Chroma tenant 名称。
# 本地默认使用 default_tenant；除非你显式创建了其他 tenant，否则不要改。
CHROMA_TENANT=default_tenant

# Chroma database 名称。
# 本地默认使用 default_database；除非你显式创建了其他 database，否则不要改。
CHROMA_DATABASE=default_database

# Chroma 访问 token。
# 本地无鉴权 Chroma 可以留空；如果 Chroma 服务开启鉴权，则填写对应 token。
CHROMA_TOKEN=

# Chroma collection 前缀。
# 系统会为每个知识库创建独立 collection，该前缀用于避免与其他项目的 collection 冲突。
CHROMA_COLLECTION_PREFIX=rag_kb_

# 文档分块最大字符数。
# 数值越大，单个片段包含上下文越多，但检索粒度越粗；默认 1200 适合课程演示。
CHUNK_MAX_CHARS=1200

# 文档分块重叠字符数。
# 用于让相邻片段共享部分上下文，降低切分导致的信息断裂；应小于 CHUNK_MAX_CHARS。
CHUNK_OVERLAP_CHARS=120

# RAG 检索返回片段数量。
# top-k 越大，提供给模型的参考片段越多，但 prompt 更长、成本更高。
RAG_TOP_K=5

# RAG 低相似度阈值。
# 检索结果最高分低于该阈值时，系统会提示知识库中未找到相关内容，避免强行胡编。
RAG_LOW_SCORE_THRESHOLD=0.35

# RAG query rewrite 使用的历史轮数。
# 用于结合最近对话改写用户问题；0 表示不使用历史消息，4 表示最多参考最近 4 轮。
RAG_HISTORY_TURNS=4
